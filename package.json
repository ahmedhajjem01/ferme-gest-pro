{
  "name": "ferme-gest-pro",
  "version": "1.0.0",
  "description": "FermeGest Pro - Application Mobile et PWA de Gestion d'Élevage, Finances & Incubateur (iOS & Android)",
  "main": "app.js",
  "scripts": {
    "build": "node scripts/build-mobile.js",
    "sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "run:android": "npx cap run android",
    "build:apk": "npm run sync && cd android && gradlew.bat assembleDebug && cd .."
  },
  "keywords": [
    "ferme",
    "aviculture",
    "elevage",
    "incubateur",
    "gestion",
    "mobile",
    "android",
    "ios",
    "capacitor"
  ],
  "author": "FermeGest Pro Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
